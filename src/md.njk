---
# Emits the raw-Markdown twin of every content page at /<slug>/index.md.
# One template, paginated over every page tagged `page`.
pagination:
  data: collections.page
  size: 1
  alias: doc
permalink: "{{ doc.url }}index.md"
eleventyExcludeFromCollections: true
---
# {{ doc.data.title }}
{%- if doc.data.description %}

> {{ doc.data.description }}
{%- endif %}

{{ doc.rawInput | safe }}
