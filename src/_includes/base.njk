<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ description or site.description }}" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌿</text></svg>" />
  {# Point agents/LLMs at the raw Markdown source of this page. #}
  <link rel="alternate" type="text/markdown" href="{{ mdUrl }}" title="Markdown version" />
  <style>
    :root {
      color-scheme: light dark;
      --bg: #ffffff;
      --fg: #1a1a1a;
      --muted: #666;
      --accent: #2e7d5b;
      --card: #f5f6f5;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0f1211;
        --fg: #e8eae9;
        --muted: #9aa3a0;
        --accent: #5fd6a0;
        --card: #171b1a;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--fg);
      line-height: 1.6;
      display: flex;
      min-height: 100vh;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }
    main { max-width: 640px; width: 100%; }
    .badge {
      display: inline-block;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      font-weight: 600;
    }
    h1 { font-size: clamp(2rem, 6vw, 3.25rem); margin: 0.25rem 0 0.5rem; }
    /* The first paragraph of Markdown content reads as the lead. */
    .content > p:first-of-type { font-size: 1.15rem; color: var(--muted); margin-top: 0; }
    .content a { color: var(--accent); }
    /* A top-level Markdown list renders as a row of link buttons. */
    .content ul {
      list-style: none;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.75rem;
    }
    .content ul a {
      text-decoration: none;
      color: var(--fg);
      background: var(--card);
      padding: 0.6rem 1.1rem;
      border-radius: 0.6rem;
      font-weight: 500;
      display: inline-block;
      transition: transform 0.12s ease, color 0.12s ease;
    }
    .content ul a:hover { transform: translateY(-2px); color: var(--accent); }
    footer { margin-top: 2.5rem; font-size: 0.85rem; color: var(--muted); }
  </style>
</head>
<body>
  <main>
    <span class="badge">🌿 Portfoliage</span>
    <h1>{{ title or site.title }}</h1>
    <div class="content">
      {{ content | safe }}
    </div>
    <footer>Served statically on Fly.io. <a href="{{ mdUrl }}">Markdown version →</a></footer>
  </main>
</body>
</html>
